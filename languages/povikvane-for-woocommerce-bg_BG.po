msgid "This site cannot be connected with one click. Use the API key instead."
msgstr "Този сайт не може да се свърже с един клик. Използвайте API ключ."

#. translators: %s: shop name.
#: src/Admin/ConnectPanel.php:217
#, php-format
msgid "Connected as \"%s\"."
msgstr "Свързан като „%s“."

#: src/Admin/ConnectPanel.php:229
msgid "The connection was not approved. Nothing was changed."
msgstr "Връзката не беше одобрена. Нищо не е променено."

#: src/Admin/ConnectPanel.php:231
msgid "The connection did not work. Press \"Connect with Povikvane\" to start again."
msgstr "Свързването не успя. Натиснете „Свържи с Povikvane“, за да започнете отново."

#: src/Admin/ConnectPanel.php:249
msgid "This shop is disconnected. Connect again whenever you want to send messages."
msgstr "Връзката на магазина е прекъсната. Свържете отново, когато искате да изпращате съобщения."

#: src/Admin/ConnectionPanel.php:46
msgid "Approve this shop in your Povikvane account and the key, service ID and delivery-report address are set up for you."
msgstr "Одобрете този магазин във вашия акаунт в Povikvane и ключът, идентификаторът на услугата и адресът за отчети се настройват вместо вас."

#: src/Admin/ConnectionPanel.php:51
msgid "Find your API key and service ID in Povikvane under Settings > API. They stay on this site, and the key is stored encrypted."
msgstr "Намерете API ключа и идентификатора на услугата в Povikvane, под Настройки > API. Те остават на този сайт, а ключът се съхранява криптиран."

#: src/Admin/ConnectionPanel.php:51
msgid "Your Povikvane account"
msgstr "Вашият Povikvane акаунт"

#: src/Admin/ConnectionPanel.php:53 src/Admin/SetupWizard.php:279
#: src/Admin/SetupWizard.php:283
msgid "API key"
msgstr "API ключ"

#: src/Admin/ConnectionPanel.php:56 src/Admin/SetupWizard.php:280
msgid "Set in wp-config.php"
msgstr "Зададен в wp-config.php"

#: src/Admin/ConnectionPanel.php:61 src/Admin/SetupWizard.php:286
msgid "Saved. Type a new key to replace it."
msgstr "Запазен. Въведете нов ключ, за да го смените."

#: src/Admin/ConnectionPanel.php:65
msgid "The saved key can no longer be read (the site security keys changed). Enter it again."
msgstr "Запазеният ключ вече не може да бъде прочетен (сменени са защитните ключове на сайта). Въведете го отново."

#: src/Admin/ConnectionPanel.php:69
msgid "Remove the saved key"
msgstr "Премахни запазения ключ"

#: src/Admin/ConnectionPanel.php:75 src/Admin/SetupWizard.php:292
msgid "Service ID"
msgstr "Идентификатор на услугата"

#: src/Admin/ConnectionPanel.php:83 src/Admin/SetupWizard.php:231
msgid "Open Povikvane"
msgstr "Отвори Povikvane"

#: src/Admin/ConnectionPanel.php:85
msgid "Defaults"
msgstr "По подразбиране"

#: src/Admin/ConnectionPanel.php:87
msgid "Default country"
msgstr "Държава по подразбиране"

#: src/Admin/ConnectionPanel.php:87 src/Admin/SetupWizard.php:296
msgid "Used to read phone numbers written without a country code."
msgstr "Използва се за разпознаване на телефонни номера, записани без код на държава."

#: src/Admin/ConnectionPanel.php:95 src/Admin/TemplatesSection.php:283
msgid "Language"
msgstr "Език"

#: src/Admin/ConnectionPanel.php:95
msgid "Sets the wording of customer messages. \"Automatic\" follows the site language. Each person can pick their own language for these screens in the header."
msgstr "Определя текста на съобщенията до клиентите. „Автоматично“ следва езика на сайта. Всеки може да избере собствен език за тези екрани от заглавната лента."

#: src/Admin/ConnectionPanel.php:98
msgid "Automatic (follow the site language)"
msgstr "Автоматично (според езика на сайта)"

#: src/Admin/ConsentColumns.php:60 src/Admin/ConsentColumns.php:151
msgid "SMS promotions"
msgstr "Промоционални SMS"

#: src/Admin/ConsentColumns.php:84
msgid "Has not agreed"
msgstr "Няма съгласие"

#: src/Admin/ConsentColumns.php:87 src/Admin/ConsentColumns.php:152
#: src/Privacy/Privacy.php:167
msgid "Agreed"
msgstr "Съгласие"

#: src/Admin/ConsentColumns.php:102
msgid "Consent"
msgstr "Съгласие"

#: src/Admin/ConsentColumns.php:102
msgid "Promotional SMS"
