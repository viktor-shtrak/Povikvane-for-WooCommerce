#: src/Admin/ViberPanel.php:41 src/Privacy/Privacy.php:138
msgid "Status"
msgstr "Статус"

#: src/Admin/MarketingSection.php:86
msgid "Ask customers for their agreement and allow promotional messages"
msgstr "Искай съгласие от клиентите и разреши промоционални съобщения"

#: src/Admin/MarketingSection.php:86
msgid "Off by default. Nothing promotional is ever sent while this is off."
msgstr "По подразбиране е изключено. Докато е изключено, никога не се изпраща нищо промоционално."

#: src/Admin/MarketingSection.php:89
msgid "Checkbox wording"
msgstr "Текст до отметката"

#: src/Admin/MarketingSection.php:89
msgid "Shown next to the unticked checkbox at checkout and in My Account. A short fingerprint of the wording is stored with each agreement."
msgstr "Показва се до неотбелязаната отметка при плащането и в „Моят акаунт“. Заедно с всяко съгласие се съхранява кратък отпечатък на текста."

#: src/Admin/MarketingSection.php:99
msgid "When and how often"
msgstr "Кога и колко често"

#: src/Admin/MarketingSection.php:101
