#: src/Admin/ChannelLabel.php:28 src/Admin/TemplatesSection.php:172
msgid "SMS"
msgstr "SMS"

#: src/Admin/ChannelLabel.php:32
msgid "Viber, delivered by SMS"
msgstr "Viber, доставено по SMS"

